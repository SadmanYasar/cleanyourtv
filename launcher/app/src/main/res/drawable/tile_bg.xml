<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: luminous aqua glass focus outline -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2000E5FF" />
                    <corners android:radius="20dp" />
                    <stroke android:width="2.5dp" android:color="#CCFFFFFF" />
                </shape>
            </item>
            <item android:bottom="48dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:endColor="#05FFFFFF" />
                    <corners
                        android:topLeftRadius="18dp"
                        android:topRightRadius="18dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Unfocused state: fully transparent with zero black borders/background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>

